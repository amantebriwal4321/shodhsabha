# ShodhSabha reads these on the server. None are required.
# With no model key, the app replays recorded runs and can still gather
# keyless public sources for a question it has not recorded.

# --- Council brain ---
# First complete provider wins: Lyzr (key + agent id), then OpenAI, Groq, Gemini.

LYZR_API_KEY=
LYZR_USER_ID=shodhsabha
# One Studio agent can play every seat. Per-seat ids override it.
LYZR_AGENT_ID=
LYZR_PLANNER_AGENT_ID=
LYZR_WEB_SCOUT_AGENT_ID=
LYZR_PAPER_SCOUT_AGENT_ID=
LYZR_SKEPTIC_AGENT_ID=
LYZR_FACT_CHECKER_AGENT_ID=
LYZR_SCRIBE_AGENT_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- BAND (app.band.ai) ---
# The web app mirrors each live A2A line into a room with POST
# /api/v1/agent/chats/{chat_id}/messages. The agent must already be in the room.
# A message needs a mention, so set the handle of someone else in the room.
# npm run band:bridge keeps a websocket agent up (SDK) for inbound mentions.

BAND_API_KEY=
BAND_AGENT_ID=
BAND_CHAT_ID=
BAND_MENTION_HANDLE=
BAND_MENTION_ID=
BAND_REST_URL=https://app.band.ai/api/v1

# --- Finch (finchtech.ai) provider runtime ---
# Point a Finch hosted-agent runtime at:
#   health  GET  /api/finch/health
#   invoke  POST /api/finch/invoke
#   task    GET  /api/finch/tasks/{merchant_task_id}
# Signing follows the published HMAC canonical string. Without the secret,
# the routes still answer, unsigned, so you can curl them locally.

FINCH_KEY_ID=
FINCH_REQUEST_SECRET=
FINCH_WIRE_PROTOCOL=finch_v2

# --- Agent37 ---
# Calls POST {INSTANCE_URL}/v1/responses on an instance you already run.
# AUTO_CREATE=true spends wallet credit (template agent37-hermes, $1 budget cap).
# Leave it false unless you mean to pay.

AGENT37_API_KEY=
AGENT37_INSTANCE_URL=
AGENT37_AUTO_CREATE=false
AGENT37_TEMPLATE=agent37-hermes

# --- AdaL CLI (local coding agent) ---
# Used only when the `adal` binary is on PATH and already logged in.
# ADAL_ENABLED=false skips the shell-out even if the binary exists.

ADAL_ENABLED=true

# Optional polite-pool key for OpenAlex. The app works without it.
OPENALEX_API_KEY=

# Milliseconds between recorded-run messages. Tests set 0.
DEMO_PACE_MS=700
